# Release rules from the harness, generated by make-codex-starter.mjs from RELEASE_RULES.
# "prompt" asks you before the command runs; "forbidden" refuses it.
# Check one: codex execpolicy check --pretty --rules <this file> -- git push origin main

prefix_rule(
    pattern = ["git","push",["--force","-f","--force-with-lease","--mirror"]],
    decision = "forbidden",
    justification = "Never force-push. Push a new branch and open a PR.",
    match = ["git push --force origin main","git push -f"],
    not_match = ["git push origin task/x"],
)

prefix_rule(
    pattern = ["git","push","origin",["--force","-f","--force-with-lease","--mirror"]],
    decision = "forbidden",
    justification = "Never force-push. Push a new branch and open a PR.",
    match = ["git push origin --force task/x"],
    not_match = ["git push origin task/x"],
)

prefix_rule(
    pattern = ["git","push","origin",["+main","+master","+HEAD:main","+HEAD:master"]],
    decision = "forbidden",
    justification = "A + refspec is a force push. Push a new branch and open a PR.",
    match = ["git push origin +main"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git","push",["origin","upstream"],["main","master","HEAD:main","HEAD:master"]],
    decision = "prompt",
    justification = "Pushing the default branch is public. It needs the owner's go-ahead; open a PR instead.",
    match = ["git push origin main","git push origin HEAD:main"],
    not_match = ["git push origin task/x"],
)

prefix_rule(
    pattern = ["git","push","upstream"],
    decision = "forbidden",
    justification = "upstream is someone else's repo. Push only to origin.",
    match = ["git push upstream task/x"],
    not_match = ["git push origin task/x"],
)

prefix_rule(
    pattern = ["gh","pr","merge"],
    decision = "prompt",
    justification = "Merging is the owner's call unless they said go ahead in this session.",
    match = ["gh pr merge 12 -R me/app"],
    not_match = ["gh pr view 12"],
)

prefix_rule(
    pattern = ["gh","repo","create"],
    decision = "prompt",
    justification = "A new GitHub repo may be public. Ask the owner first.",
    match = ["gh repo create app --public"],
    not_match = ["gh repo view"],
)

prefix_rule(
    pattern = ["vercel",["--prod","promote"]],
    decision = "prompt",
    justification = "A production deploy is public. It needs the owner's go-ahead.",
    match = ["vercel --prod"],
    not_match = ["vercel deploy"],
)

prefix_rule(
    pattern = ["vercel","deploy","--prod"],
    decision = "prompt",
    justification = "A production deploy is public. It needs the owner's go-ahead.",
    match = ["vercel deploy --prod"],
    not_match = ["vercel deploy"],
)

prefix_rule(
    pattern = [["npm","pnpm","yarn"],"publish"],
    decision = "prompt",
    justification = "Publishing a package is public. It needs the owner's go-ahead.",
    match = ["npm publish"],
    not_match = ["npm test"],
)
